# 이 파일을 복사해 프로젝트 루트에 .env 를 만듭니다.
# cp .env.example .env
# .env 에는 실제 비밀번호를 넣고, Git에는 올리지 않습니다.

# 로컬 MySQL. Docker Compose는 앱 컨테이너 주소만 mysql 호스트로 따로 넣습니다.
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/petcare?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# docker compose 의 MySQL 컨테이너
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=petcare
MYSQL_USER=petcare
MYSQL_PASSWORD=

# admin 계정이 데이터베이스에 없을 때만 사용합니다.
# 이미 있는 관리자 비밀번호 해시는 서버를 다시 켜도 바뀌지 않습니다.
PETCARE_ADMIN_INITIAL_PASSWORD=
